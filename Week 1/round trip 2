#include <bits/stdc++.h>
using namespace std;

int n, m;

vector<vector<int>> adj;
vector<int> state;
vector<int> parent;
vector<int> cycle;

bool dfs(int u) {
    state[u] = 1;

    for (int v : adj[u]) {

        if (state[v] == 0) {
            parent[v] = u;

            if (dfs(v))
                return true;
        }
        else if (state[v] == 1) {

            cycle.push_back(v);

            int cur = u;

            while (cur != v) {
                cycle.push_back(cur);
                cur = parent[cur];
            }

            cycle.push_back(v);

            reverse(cycle.begin(), cycle.end());

            return true;
        }
    }

    state[u] = 2;
    return false;
}

int main() {
    cin >> n >> m;

    adj.resize(n + 1);
    state.assign(n + 1, 0);
    parent.assign(n + 1, -1);

    for (int i = 0; i < m; i++) {
        int a, b;
        cin >> a >> b;
        adj[a].push_back(b);
    }

    for (int i = 1; i <= n; i++) {
        if (state[i] == 0) {
            if (dfs(i))
                break;
        }
    }

    if (cycle.empty()) {
        cout << "IMPOSSIBLE\n";
        return 0;
    }

    cout << cycle.size() << "\n";

    for (int x : cycle)
        cout << x << " ";

    cout << "\n";
}