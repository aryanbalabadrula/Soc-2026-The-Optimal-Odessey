#include <bits/stdc++.h>
using namespace std;

using ll = long long;

struct DSU {
    vector<int> parent, sz;

    DSU(int n) {
        parent.resize(n + 1);
        sz.assign(n + 1, 1);

        for (int i = 1; i <= n; i++)
            parent[i] = i;
    }

    int find(int x) {
        if (x == parent[x])
            return x;
        return parent[x] = find(parent[x]);
    }

    bool unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a == b)
            return false;

        if (sz[a] < sz[b])
            swap(a, b);

        parent[b] = a;
        sz[a] += sz[b];

        return true;
    }
};

struct Edge {
    int a, b;
    ll c;

    bool operator<(const Edge& other) const {
        return c < other.c;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<Edge> edges(m);

    for (int i = 0; i < m; i++) {
        cin >> edges[i].a
            >> edges[i].b
            >> edges[i].c;
    }

    sort(edges.begin(), edges.end());

    DSU dsu(n);

    ll ans = 0;
    int used = 0;

    for (auto e : edges) {
        if (dsu.unite(e.a, e.b)) {
            ans += e.c;
            used++;
        }
    }

    if (used != n - 1) {
        cout << "IMPOSSIBLE\n";
        return 0;
    }

    cout << ans << "\n";
}